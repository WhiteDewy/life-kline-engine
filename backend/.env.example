LIFE_KLINE_HOST=0.0.0.0
LIFE_KLINE_PORT=8000
LIFE_KLINE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
LIFE_KLINE_GEOCODE_TIMEOUT=4
LIFE_KLINE_AMAP_KEY=

# LLM 配置（星灵 AI 对话，不配置则仅用引擎规则回复）
# 支持 provider: deepseek | claude | qwen
LIFE_KLINE_LLM_PROVIDER=deepseek
LIFE_KLINE_LLM_API_KEY=
DEEPSEEK_API_KEY=
LIFE_KLINE_LLM_MODEL=deepseek-v4-flash
LIFE_KLINE_LLM_MAX_TOKENS=1500

# 鉴权密钥（生产必须设置，否则 token 可伪造）：用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成
LIFE_KLINE_JWT_SECRET=

# Redis（星灵咨询短期状态 / token 预算外置；留空则降级为进程内存，仅开发可用）
LIFE_KLINE_REDIS_URL=

# 星灵深度咨询（token 预算与免费闭环边界）
LIFE_KLINE_CONSULTATION_TOKEN_DAILY=20000
LIFE_KLINE_CONSULTATION_TOKEN_PER_TURN=1500

# 计费 / 支付（P1.2）
# dev 验证旁路：仅测试用户或此处=1 时 /billing/verify 跳过渠道校验直发。生产必须留空。
LIFE_KLINE_DEV_BYPASS=
# iOS IAP 校验（Apple verifyReceipt）
APPLE_SHARED_SECRET=
APPLE_BUNDLE_ID=
# 安卓微信支付
WXPAY_MCH_ID=
WXPAY_API_KEY=
# 安卓支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=

# ⚠️ 生产部署：LIFE_KLINE_CORS_ORIGINS 必须收敛到正式域名（如 https://garden.example.com），
# 禁止使用 *。已完成 ICP 备案后方可对外提供服务。

